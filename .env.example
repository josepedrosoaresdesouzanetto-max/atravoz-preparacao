# Valores reais nunca devem entrar no Git.
APP_NAME=ATRAVOZ
# Defina localmente um token aleatório com pelo menos 32 caracteres.
OPERATOR_TOKEN=
DATABASE_PATH=runtime/incidents.sqlite3
AI_PROVIDER=rules
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Opcional: autoridade mesh. Chaves PEM cifradas, geradas por scripts/provision_mesh.py.
MESH_KEY_DIR=runtime/mesh-keys
MESH_KEY_PASSWORD=
# Loopback permanece padrão. LAN exige certificado confiável nos aparelhos.
HOST=127.0.0.1
PORT=8000
TLS_CERT_FILE=
TLS_KEY_FILE=
